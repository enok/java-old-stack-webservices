        <sc:firstName>Sanna</sc:firstName>
        <sc:dateOfBirth>19/07/1998</sc:dateOfBirth>
        <sc:programCode>BBA</sc:programCode>
        <sc:enrollmentStatus>A</sc:enrollmentStatus>
        <sc:campusCode>RV-CENTRAL</sc:campusCode>
        <sc:rivertonCampusId>RVC-88120</sc:rivertonCampusId>
        <sc:advisorNetworkId>slindqvist</sc:advisorNetworkId>
        <sc:residencyIndicator>IS</sc:residencyIndicator>
