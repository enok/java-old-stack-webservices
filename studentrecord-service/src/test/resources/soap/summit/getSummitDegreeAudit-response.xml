      <sm:auditXml>&lt;DegreeAudit studentId="S9900771" catalogYear="2019-2020"&gt;&lt;Holds count="2"&gt;&lt;Hold code="ADV"&gt;Degree audit review&lt;/Hold&gt;&lt;Hold code="IMM"&gt;Immunisation record incomplete&lt;/Hold&gt;&lt;/Holds&gt;&lt;Requirements status="NOT_IMPLEMENTED"/&gt;&lt;/DegreeAudit&gt;</sm:auditXml>
      <sm:generatedOn>01-15-2024</sm:generatedOn>
    </sm:getSummitDegreeAuditResponse>
  </soap:Body>
</soap:Envelope>
