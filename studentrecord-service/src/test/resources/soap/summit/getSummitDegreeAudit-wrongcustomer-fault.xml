<?xml version="1.0" encoding="UTF-8"?>
<!--
  What NORTHLAKE gets if it calls the SUMMIT-only operation. The operation is
  in the shared portType, so their generated client has the method; the
  rejection is a runtime check in StudentRecordEndpointImpl, not a contract
  boundary. SMELL #1.
-->
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/">
  <soap:Body>
    <soap:Fault>
      <faultcode>soap:Server</faultcode>
      <faultstring>getSummitDegreeAudit is not available for NORTHLAKE</faultstring>
      <detail>
        <sm:studentServiceFault xmlns:sm="http://campusconnect.example.edu/sis/student/messages/v1"
                                xmlns:sc="http://campusconnect.example.edu/sis/student/common/v1">
          <sc:faultCode>SIS-4003</sc:faultCode>
          <sc:faultMessage>getSummitDegreeAudit is not available for NORTHLAKE</sc:faultMessage>
        </sm:studentServiceFault>
      </detail>
    </soap:Fault>
  </soap:Body>
</soap:Envelope>
