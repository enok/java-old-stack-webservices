<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  CampusConnect StudentRecordService - PUBLISHED CONTRACT v1
  ============================================================================
  This WSDL is hand-written and is the source of truth. Java is generated from
  it by cxf-codegen-plugin at build time (contract-first).

  !! DO NOT EDIT THIS FILE WITHOUT A CONSUMER IMPACT REVIEW !!
  Three institutions (NORTHLAKE, RIVERTON, SUMMIT) are bound to the element
  ordering and namespaces below. Changing a published WSDL breaks consumers;
  see docs/MODERNIZATION-BACKLOG.md for why the strangler ordering matters.
  ============================================================================
-->
<wsdl:definitions
    name="StudentRecordService"
    targetNamespace="http://campusconnect.example.edu/sis/studentrecord/v1"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://campusconnect.example.edu/sis/studentrecord/v1"
    xmlns:sm="http://campusconnect.example.edu/sis/student/messages/v1">

  <wsdl:types>
    <xs:schema targetNamespace="http://campusconnect.example.edu/sis/studentrecord/v1"
               elementFormDefault="qualified">
      <xs:import namespace="http://campusconnect.example.edu/sis/student/messages/v1"
                 schemaLocation="xsd/student-messages.xsd"/>
    </xs:schema>
  </wsdl:types>

  <!-- ====================== messages ====================== -->
  <wsdl:message name="getStudentRequest">
    <wsdl:part name="parameters" element="sm:getStudentRequest"/>
  </wsdl:message>
  <wsdl:message name="getStudentResponse">
    <wsdl:part name="parameters" element="sm:getStudentResponse"/>
  </wsdl:message>

  <wsdl:message name="findStudentsByTermRequest">
    <wsdl:part name="parameters" element="sm:findStudentsByTermRequest"/>
  </wsdl:message>
  <wsdl:message name="findStudentsByTermResponse">
    <wsdl:part name="parameters" element="sm:findStudentsByTermResponse"/>
  </wsdl:message>

  <wsdl:message name="submitEnrollmentChangeRequest">
    <wsdl:part name="parameters" element="sm:submitEnrollmentChangeRequest"/>
  </wsdl:message>
  <wsdl:message name="submitEnrollmentChangeResponse">
    <wsdl:part name="parameters" element="sm:submitEnrollmentChangeResponse"/>
  </wsdl:message>

  <wsdl:message name="getAdvisingHoldsRequest">
    <wsdl:part name="parameters" element="sm:getAdvisingHoldsRequest"/>
  </wsdl:message>
  <wsdl:message name="getAdvisingHoldsResponse">
    <wsdl:part name="parameters" element="sm:getAdvisingHoldsResponse"/>
  </wsdl:message>

  <wsdl:message name="getSummitDegreeAuditRequest">
    <wsdl:part name="parameters" element="sm:getSummitDegreeAuditRequest"/>
  </wsdl:message>
  <wsdl:message name="getSummitDegreeAuditResponse">
    <wsdl:part name="parameters" element="sm:getSummitDegreeAuditResponse"/>
  </wsdl:message>

  <!-- RIVERTON FORK -->
  <wsdl:message name="getRivertonResidencyStatusRequest">
    <wsdl:part name="parameters" element="sm:getRivertonResidencyStatusRequest"/>
  </wsdl:message>
  <wsdl:message name="getRivertonResidencyStatusResponse">
    <wsdl:part name="parameters" element="sm:getRivertonResidencyStatusResponse"/>
  </wsdl:message>

  <wsdl:message name="StudentServiceFault">
    <wsdl:part name="fault" element="sm:studentServiceFault"/>
  </wsdl:message>

  <!-- ====================== portType ====================== -->
  <wsdl:portType name="StudentRecordPortType">

    <!--
      NOTE: getStudent declares NO fault. On "not found" it returns an empty
      getStudentResponse. This is inconsistent with getAdvisingHolds below and
      is tracked as SMELL #5a.
    -->
    <wsdl:operation name="getStudent">
      <wsdl:input  name="getStudentRequest"  message="tns:getStudentRequest"/>
      <wsdl:output name="getStudentResponse" message="tns:getStudentResponse"/>
    </wsdl:operation>

    <wsdl:operation name="findStudentsByTerm">
      <wsdl:input  name="findStudentsByTermRequest"  message="tns:findStudentsByTermRequest"/>
      <wsdl:output name="findStudentsByTermResponse" message="tns:findStudentsByTermResponse"/>
      <wsdl:fault  name="StudentServiceFault"        message="tns:StudentServiceFault"/>
    </wsdl:operation>

    <wsdl:operation name="submitEnrollmentChange">
      <wsdl:input  name="submitEnrollmentChangeRequest"  message="tns:submitEnrollmentChangeRequest"/>
      <wsdl:output name="submitEnrollmentChangeResponse" message="tns:submitEnrollmentChangeResponse"/>
      <wsdl:fault  name="StudentServiceFault"            message="tns:StudentServiceFault"/>
    </wsdl:operation>

    <wsdl:operation name="getAdvisingHolds">
      <wsdl:input  name="getAdvisingHoldsRequest"  message="tns:getAdvisingHoldsRequest"/>
      <wsdl:output name="getAdvisingHoldsResponse" message="tns:getAdvisingHoldsResponse"/>
      <wsdl:fault  name="StudentServiceFault"      message="tns:StudentServiceFault"/>
    </wsdl:operation>

    <!-- SUMMIT-only operation. See docs/FORKS.md. -->
    <wsdl:operation name="getSummitDegreeAudit">
      <wsdl:input  name="getSummitDegreeAuditRequest"  message="tns:getSummitDegreeAuditRequest"/>
      <wsdl:output name="getSummitDegreeAuditResponse" message="tns:getSummitDegreeAuditResponse"/>
      <wsdl:fault  name="StudentServiceFault"          message="tns:StudentServiceFault"/>
    </wsdl:operation>

    <!-- RIVERTON FORK: an operation that exists only on this branch. -->
    <wsdl:operation name="getRivertonResidencyStatus">
      <wsdl:input  name="getRivertonResidencyStatusRequest"  message="tns:getRivertonResidencyStatusRequest"/>
      <wsdl:output name="getRivertonResidencyStatusResponse" message="tns:getRivertonResidencyStatusResponse"/>
      <wsdl:fault  name="StudentServiceFault"                message="tns:StudentServiceFault"/>
    </wsdl:operation>

  </wsdl:portType>

  <!-- ====================== binding ======================= -->
  <!--
    XXX: no WS-Security policy here. Authentication is a homegrown
    <cc:CampusConnectAuth> SOAP header enforced by SharedSecretAuthHandler.
    That header is NOT declared in this WSDL, so consumers had to be told about
    it by email. See SMELL (auth) in docs/LEGACY-SMELLS.md.
  -->
  <wsdl:binding name="StudentRecordSoapBinding" type="tns:StudentRecordPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>

    <wsdl:operation name="getStudent">
      <soap:operation soapAction="urn:campusconnect:sis:getStudent" style="document"/>
      <wsdl:input  name="getStudentRequest"><soap:body use="literal"/></wsdl:input>
      <wsdl:output name="getStudentResponse"><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>

    <wsdl:operation name="findStudentsByTerm">
      <soap:operation soapAction="urn:campusconnect:sis:findStudentsByTerm" style="document"/>
      <wsdl:input  name="findStudentsByTermRequest"><soap:body use="literal"/></wsdl:input>
      <wsdl:output name="findStudentsByTermResponse"><soap:body use="literal"/></wsdl:output>
      <wsdl:fault  name="StudentServiceFault">
        <soap:fault name="StudentServiceFault" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>

    <wsdl:operation name="submitEnrollmentChange">
      <soap:operation soapAction="urn:campusconnect:sis:submitEnrollmentChange" style="document"/>
      <wsdl:input  name="submitEnrollmentChangeRequest"><soap:body use="literal"/></wsdl:input>
      <wsdl:output name="submitEnrollmentChangeResponse"><soap:body use="literal"/></wsdl:output>
      <wsdl:fault  name="StudentServiceFault">
        <soap:fault name="StudentServiceFault" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>

    <wsdl:operation name="getAdvisingHolds">
      <soap:operation soapAction="urn:campusconnect:sis:getAdvisingHolds" style="document"/>
      <wsdl:input  name="getAdvisingHoldsRequest"><soap:body use="literal"/></wsdl:input>
      <wsdl:output name="getAdvisingHoldsResponse"><soap:body use="literal"/></wsdl:output>
      <wsdl:fault  name="StudentServiceFault">
        <soap:fault name="StudentServiceFault" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>

    <wsdl:operation name="getSummitDegreeAudit">
      <soap:operation soapAction="urn:campusconnect:sis:getSummitDegreeAudit" style="document"/>
      <wsdl:input  name="getSummitDegreeAuditRequest"><soap:body use="literal"/></wsdl:input>
      <wsdl:output name="getSummitDegreeAuditResponse"><soap:body use="literal"/></wsdl:output>
      <wsdl:fault  name="StudentServiceFault">
        <soap:fault name="StudentServiceFault" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>

    <!-- RIVERTON FORK -->
    <wsdl:operation name="getRivertonResidencyStatus">
      <soap:operation soapAction="urn:campusconnect:sis:getRivertonResidencyStatus" style="document"/>
      <wsdl:input  name="getRivertonResidencyStatusRequest"><soap:body use="literal"/></wsdl:input>
      <wsdl:output name="getRivertonResidencyStatusResponse"><soap:body use="literal"/></wsdl:output>
      <wsdl:fault  name="StudentServiceFault">
        <soap:fault name="StudentServiceFault" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>

  </wsdl:binding>

  <!-- ====================== service ======================= -->
  <wsdl:service name="StudentRecordService">
    <wsdl:port name="StudentRecordPort" binding="tns:StudentRecordSoapBinding">
      <!-- Replaced at deploy time by Ansible; see ansible/deploy.yml -->
      <soap:address location="http://localhost:8080/studentrecord/services/StudentRecordService"/>
    </wsdl:port>
  </wsdl:service>

</wsdl:definitions>
