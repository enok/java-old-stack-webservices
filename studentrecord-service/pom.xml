<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.campusconnect.sis</groupId>
    <artifactId>studentrecord-parent</artifactId>
    <version>1.7.0-SNAPSHOT</version>
  </parent>

  <artifactId>studentrecord-service</artifactId>
  <packaging>jar</packaging>
  <name>CampusConnect :: StudentRecordService :: service</name>

  <dependencies>
    <dependency>
      <groupId>com.campusconnect.sis</groupId>
      <artifactId>studentrecord-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.campusconnect.sis</groupId>
      <artifactId>studentrecord-dao</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-frontend-jaxws</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-transports-http</artifactId>
    </dependency>
    <!-- ONE legacy "REST-ish" endpoint. Same CXF bus, different frontend. -->
    <dependency>
      <groupId>org.apache.cxf</groupId>
      <artifactId>cxf-rt-frontend-jaxrs</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>

    <dependency>
      <groupId>javax.xml.bind</groupId>
      <artifactId>jaxb-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sun.xml.bind</groupId>
      <artifactId>jaxb-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sun.xml.bind</groupId>
      <artifactId>jaxb-impl</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>commons-lang</groupId>
      <artifactId>commons-lang</artifactId>
    </dependency>
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        CONTRACT-FIRST. src/main/resources/wsdl/StudentRecordService.wsdl is the
        source of truth; every JAX-WS/JAXB class below target/generated-sources
        comes from it. Do not hand-edit generated code; it is regenerated on
        every build.
      -->
      <plugin>
        <groupId>org.apache.cxf</groupId>
        <artifactId>cxf-codegen-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-sources-from-wsdl</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>wsdl2java</goal>
            </goals>
            <configuration>
              <sourceRoot>${project.build.directory}/generated-sources/cxf</sourceRoot>
              <wsdlOptions>
                <wsdlOption>
                  <wsdl>${basedir}/src/main/resources/wsdl/StudentRecordService.wsdl</wsdl>
                  <wsdlLocation>classpath:wsdl/StudentRecordService.wsdl</wsdlLocation>
                  <bindingFiles>
                    <bindingFile>${basedir}/src/main/resources/wsdl/bindings.xjb</bindingFile>
                    <bindingFile>${basedir}/src/main/resources/wsdl/jaxws-bindings.xml</bindingFile>
                  </bindingFiles>
                  <extraargs>
                    <!--
                      Explicit namespace -> package mapping. Without these the
                      generated packages are derived from the namespaces
                      (edu.example.campusconnect...) and every import in this
                      module breaks. Pinned in 2014, never revisited.
                    -->
                    <extraarg>-p</extraarg>
                    <extraarg>http://campusconnect.example.edu/sis/studentrecord/v1=com.campusconnect.sis.ws</extraarg>
                    <extraarg>-p</extraarg>
                    <extraarg>http://campusconnect.example.edu/sis/student/messages/v1=com.campusconnect.sis.ws.messages</extraarg>
                    <extraarg>-p</extraarg>
                    <extraarg>http://campusconnect.example.edu/sis/student/common/v1=com.campusconnect.sis.ws.common</extraarg>
                    <extraarg>-verbose</extraarg>
                  </extraargs>
                </wsdlOption>
              </wsdlOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
